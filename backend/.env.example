FLASK_ENV=development
SECRET_KEY=change_me_in_production
JWT_SECRET_KEY=change_me_too

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/admipaedia

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Email
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_password

# Security
RATE_LIMIT_DEFAULT=200 per hour
CSRF_ENABLED=true

# Socket.IO / Gunicorn runtime (authoritative production defaults)
# Socket.IO async mode must be explicit. "threading" is the supported production
# runtime together with a single gunicorn gthread worker. Eventlet is no longer the
# default because gthread+eventlet caused AttributeError: 'Response' object has no
# attribute 'status_code' during websocket upgrade. To scale horizontally, use
# multiple single-worker containers behind a sticky load balancer with the
# Flask-SocketIO Redis message queue adapter.
SOCKETIO_ASYNC_MODE=threading
GUNICORN_WORKERS=1
GUNICORN_THREADS=16
GUNICORN_TIMEOUT=120

# Misc
LOG_LEVEL=INFO
